# watsonx.ai
# IBM Cloud IAM API key used for watsonx.ai.
WX_API_KEY=
# watsonx.ai project ID.
WX_PROJECT_ID=
# Regional watsonx.ai endpoint.
WX_URL=https://eu-de.ml.cloud.ibm.com

# watsonx Orchestrate
# Existing Orchestrate ADK environment name.
WXO_ENV_NAME=project2
# Optional Orchestrate service-instance URL reference; not required by scripts/start_dev.ps1.
WXO_SERVICE_URL=
# Credential used to activate the remote Orchestrate environment.
WXO_API_KEY=

# IBM Cloud Object Storage local development values.
# Do not commit real credentials. Remote Orchestrate runtime uses the
# cos_onboarding connection instead of reading this file.
COS_API_KEY=
COS_BUCKET=agentic-onboarding-p2-9g821-01
COS_ENDPOINT=https://s3.eu-de.cloud-object-storage.appdomain.cloud
